# ============================================
# KONFIGURASI APLIKASI
# ============================================
NODE_ENV="development"
PORT=3000
APP_NAME="Express App"
API_PREFIX="/api/v1"

# ============================================
# KONFIGURASI JWT (REQUIRED)
# ============================================
# Secret key untuk signing JWT tokens
# Ganti dengan string random yang kuat di production!
# Generate: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-this-in-production-minimum-32-characters"

# JWT Access Token expiration (menit)
JWT_ACCESS_EXPIRATION_MINUTES=30

# JWT Refresh Token expiration (hari)
JWT_REFRESH_EXPIRATION_DAYS=7

# ============================================
# KONFIGURASI DATABASE (REQUIRED)
# ============================================
# Pilih salah satu opsi DATABASE_URL di bawah ini:

# Opsi 1: Docker PostgreSQL (jika menjalankan docker-compose up)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/express_db?schema=public"

# Opsi 2: Homebrew PostgreSQL (Mac)
# DATABASE_URL="postgresql://username@localhost:5432/postgres?schema=public"

# Opsi 3: External PostgreSQL (Supabase, Neon, Railway, dll.)
# DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# DATABASE_URL wajib diisi
DATABASE_URL="postgresql://username@localhost:5432/postgres?schema=public"

# ============================================
# KONFIGURASI REDIS (Opsional)
# ============================================
# Uncomment jika menggunakan Redis untuk caching/sessions
# REDIS_URL="redis://localhost:6379"

# ============================================
# KONFIGURASI CORS
# ============================================
# Origins yang diizinkan untuk mengakses API (pisahkan dengan koma)
# CORS_ORIGIN="http://localhost:3000,http://localhost:5173,https://yourdomain.com"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ============================================
# KONFIGURASI RATE LIMITING
# ============================================
# Window time untuk rate limiting (milliseconds)
# Default: 900000 (15 menit)
RATE_LIMIT_WINDOW_MS=900000

# Maksimum request per window
# Default: 100
RATE_LIMIT_MAX=100

# ============================================
# KONFIGURASI FILE UPLOAD
# ============================================
# Maksimum ukuran file (bytes)
# Default: 5242880 (5MB)
MAX_FILE_SIZE=5242880

# Tipe file yang diizinkan (pisahkan dengan koma)
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,image/webg,application/pdf"

# ============================================
# KONFIGURASI EMAIL (SMTP)
# ============================================
# Uncomment jika menggunakan fitur email
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="noreply@yourapp.com"

# ============================================
# KONFIGURASI LOGGING
# ============================================
# Level logging: error, warn, info, http, debug
LOG_LEVEL="debug"

# Log file location
# LOG_DIR="./logs"

# ============================================
# KONFIGURASI PRODUCTION
# ============================================
# Untuk production, pastikan:
# 1. NODE_ENV=production
# 2. JWT_SECRET berupa string random yang kuat
# 3. DATABASE_URL menggunakan koneksi yang aman (SSL)
# 4. CORS_ORIGIN hanya domain yang diizinkan
# 5. RATE_LIMIT_VALUE disesuaikan dengan kapasitas server

# ============================================
# CONTOH KONFIGURASI LENGKAP
# ============================================
# NODE_ENV=production
# PORT=3000
# APP_NAME="My API"
# API_PREFIX=/api/v1
# JWT_SECRET="random-secret-key-minimum-32-characters-long"
# JWT_ACCESS_EXPIRATION_MINUTES=30
# JWT_REFRESH_EXPIRATION_DAYS=7
# DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public"
# CORS_ORIGIN="https://myapp.com,https://www.myapp.com"
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
